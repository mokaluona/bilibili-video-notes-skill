# 视觉模型 API 配置
#
# 用法：复制本文件为 .env，填入真值。.env 已进 .gitignore，不会被提交、不会被推走。
#
# 三层优先级（后者覆盖前者）：
#   1. 本文件（或环境变量）里的默认值
#   2. 进程环境变量 VISION_*
#   3. 命令行参数 --api-key / --base-url / --model   ← 最高
#
# base_url / model 是「运行参数」不是「机器配置」——换提供方、换模型时
# 优先在命令行上传，不必改本文件。

# 密钥（必填，只有这一项是真·敏感信息）
VISION_API_KEY=

# 下面两项给出已知可用的默认值，不改也能跑
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
